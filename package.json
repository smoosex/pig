{
  "name": "pig",
  "version": "0.1.0",
  "description": "Desktop GUI for the pi coding agent",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "smoose",
  "license": "MIT",
  "scripts": {
    "postinstall": "bun run icons:generate && node node_modules/electron/install.js",
    "icons:generate": "bun scripts/generate-file-icons.ts",
    "app-icons:generate": "bun scripts/generate-app-icons.ts",
    "plugins:build": "bun scripts/build-system-plugins.ts",
    "dev": "bun run icons:generate && bun run plugins:build && bun scripts/prepare-mac-dev.ts && electron-vite dev",
    "build": "bun run icons:generate && bun run plugins:build && electron-vite build",
    "preview": "bun run plugins:build && bun scripts/prepare-mac-dev.ts && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "bun run icons:generate && bun run typecheck:node && bun run typecheck:web && bun run typecheck:tests",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:mac": "bun run build && electron-builder --mac",
    "build:win": "bun run build && electron-builder --win",
    "build:linux": "bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-ai": "^1.2.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/lilex": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.1",
    "@lobehub/streamdown": "^1.4.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@pierre/diffs": "^1.5.2",
    "@shadcn/react": "0.3.1",
    "@smoose/border-beam": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.17",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
