    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "defuddle": "0.19.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "ldrs": "^1.1.9",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.55.0",
    "lxgw-wenkai-lite-webfont": "^1.7.0",
    "material-icon-theme": "^5.39.0",
    "mermaid": "^12.1.0",
    "motion": "^14.1.0",
    "p-limit": "^7.3.3",
    "postcss": "^8.5.30",
    "promise.try": "^2.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.21.4",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.2",
    "tldts": "^7.4.18",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "undici": "^8.11.2",
    "unified": "^11.0.5",
    "unpdf": "^1.8.1",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "trustedDependencies": [
    "@google/genai",
    "electron",
    "electron-winstaller",
    "esbuild",
    "protobufjs"
  ],
  "patchedDependencies": {
    "@shadcn/react@0.3.1": "patches/@shadcn%2Freact@0.3.1.patch",
    "@earendil-works/pi-coding-agent@1.2.0": "patches/@earendil-works%2Fpi-coding-agent@1.2.0.patch"
  }
}
