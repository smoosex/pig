    },
    "messages": [
      {
        "role": "toolResult",
        "toolName": "read",
        "isError": false,
        "text": "本实验 checkout 已实现 WebSocket 传输；尚未核对 main。"
      }
    ],
    "expected": {
      "knowledgeKinds": [
        "knowledge"
      ],
      "mustPreserve": [
        "实验 checkout",
        "未核对 main"
      ],
      "mustNotClaim": [
        "Forge 所有分支已支持 WebSocket",
        "已经合入 main"
      ]
    }
  },
  {
    "id": "newer-explicit-correction",
    "existing": [
      {
        "kind": "knowledge",
        "text": "项目使用方案 A",
        "status": "active"
      }
    ],
    "messages": [
      {
        "role": "user",
        "text": "方案 A 已经废弃。以后这个项目统一采用方案 B。"
      }
    ],
    "expected": {
      "knowledgeKinds": [
        "knowledge"
      ],
      "preferredAction": "supersede",
      "mustPreserve": [
        "B 为当前指导",
        "A 为历史已替代结论"
      ],
      "mustNotClaim": [
        "A 和 B 同时是有效默认方案"
      ]
    }
  },
  {
    "id": "project-identity-versus-implementation",
    "messages": [
      {
        "role": "user",
        "text": "Pig 是给 pi coding agent 做 GUI 的 Electron 桌面端，我在开发它。记忆的 context 注入在 src/main/features/memory/long-term/extension.ts，SQLite 存储在 store.ts。"
      }
    ],
    "expected": {
      "knowledgeKinds": [
        "project",
        "knowledge"
      ],
      "mustPreserve": [
        "项目档案仅身份、参与和粗粒度栈",
        "代码位置仅进入当前项目知识"
      ],
      "mustNotClaim": [
        "全局项目档案包含源码模块地图",
        "其他项目也有同样的记忆实现"
      ]
    }
  }
]
